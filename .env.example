# ============================================
# PrintCart Environment Configuration
# ============================================
# Copy this file to .env and fill in values.

# --- Database (NeonDB / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/printcart?schema=public"

# --- Server ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- JWT Auth ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --- Cloudflare R2 (Optional — omit for local dev fallback) ---
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=printcart-uploads
# R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# --- PhonePe Payment Gateway ---
PHONEPE_MODE="mock" # mock | sandbox | live
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION="1"
PHONEPE_MERCHANT_ID=""
